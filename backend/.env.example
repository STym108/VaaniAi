# Vani AI Environment Configuration Template
# Copy this file to .env and insert your API keys:
# cp .env.example .env

# Sarvam AI API Key (for Saaras STT & Bulbul v3 TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API Key (for LLM reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Context & Memory
MAX_CONTEXT_TURNS=15
GUARDRAILS_STRICT_MODE=True

